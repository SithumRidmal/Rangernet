# ---------------------------------------------------------------------------
# RangerNet environment variables
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API (or "Connect" button)
# ONLY the public project URL and the publishable (anon) key belong here.
# NEVER put the database password or the service_role / secret key in the app.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...) or legacy anon key (eyJ...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phone number / short code that receives SMS conflict reports (UC-04 SMS alternative flow).
# Leave empty to hide the "Report by SMS" option.
EXPO_PUBLIC_SMS_REPORT_NUMBER=

# Storage buckets (created by the migration - only change if you renamed them)
EXPO_PUBLIC_INCIDENT_PHOTO_BUCKET=incident-photos
EXPO_PUBLIC_REPORT_PHOTO_BUCKET=report-photos

# How often (ms) the Synchronization Service retries pending offline records
EXPO_PUBLIC_SYNC_RETRY_INTERVAL_MS=30000

# Optional: Google Maps API key, only needed for standalone Android/iOS builds
# (Expo Go works without it). Read at build time by app.config.ts, not bundled.
GOOGLE_MAPS_API_KEY=
